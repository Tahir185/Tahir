<AuthorizeView>
    <Authorized>
        <div class="dropdown">
            <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-user me-2"></i>@context.User.Identity?.Name
            </button>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" href="Identity/Account/Manage">
                        <i class="fas fa-cog me-2"></i>Manage Account
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" action="Identity/Account/LogOut">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </Authorized>
    <NotAuthorized>
        <div>
            <a class="btn btn-outline-light me-2" href="Identity/Account/Register">
                <i class="fas fa-user-plus me-1"></i>Register
            </a>
            <a class="btn btn-light" href="Identity/Account/Login">
                <i class="fas fa-sign-in-alt me-1"></i>Login
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>