@page "/hotels/create"
@using HotelPortal.Data
@using HotelPortal.Models
@using Blazored.Toast.Services
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IToastService ToastService
@attribute [Authorize]

<PageTitle>Register Hotel - Hotel Portal</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h2 class="h4 mb-0">
                    <i class="fas fa-plus me-2"></i>Register New Hotel
                </h2>
            </div>
            <div class="card-body">
                <EditForm Model="@hotel" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label">Hotel Name *</label>
                            <InputText id="name" class="form-control" @bind-Value="hotel.Name" placeholder="Enter hotel name" />
                            <ValidationMessage For="@(() => hotel.Name)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6">
                            <label for="starRating" class="form-label">Star Rating *</label>
                            <InputSelect id="starRating" class="form-select" @bind-Value="hotel.StarRating">
                                <option value="1">1 Star</option>
                                <option value="2">2 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="5">5 Stars</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => hotel.StarRating)" class="text-danger" />
                        </div>
                        
                        <div class="col-12">
                            <label for="description" class="form-label">Description *</label>
                            <InputTextArea id="description" class="form-control" rows="3" @bind-Value="hotel.Description" placeholder="Describe your hotel..." />
                            <ValidationMessage For="@(() => hotel.Description)" class="text-danger" />
                        </div>
                        
                        <div class="col-12">
                            <label for="address" class="form-label">Address *</label>
                            <InputText id="address" class="form-control" @bind-Value="hotel.Address" placeholder="Enter complete address" />
                            <ValidationMessage For="@(() => hotel.Address)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6">
                            <label for="city" class="form-label">City *</label>
                            <InputText id="city" class="form-control" @bind-Value="hotel.City" placeholder="Enter city" />
                            <ValidationMessage For="@(() => hotel.City)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6">
                            <label for="country" class="form-label">Country *</label>
                            <InputText id="country" class="form-control" @bind-Value="hotel.Country" placeholder="Enter country" />
                            <ValidationMessage For="@(() => hotel.Country)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6">
                            <label for="phoneNumber" class="form-label">Phone Number *</label>
                            <InputText id="phoneNumber" class="form-control" @bind-Value="hotel.PhoneNumber" placeholder="+1-555-0123" />
                            <ValidationMessage For="@(() => hotel.PhoneNumber)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6">
                            <label for="email" class="form-label">Email *</label>
                            <InputText id="email" type="email" class="form-control" @bind-Value="hotel.Email" placeholder="contact@hotel.com" />
                            <ValidationMessage For="@(() => hotel.Email)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6">
                            <label for="website" class="form-label">Website</label>
                            <InputText id="website" type="url" class="form-control" @bind-Value="hotel.Website" placeholder="https://hotel.com" />
                            <ValidationMessage For="@(() => hotel.Website)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6">
                            <label for="imageUrl" class="form-label">Image URL</label>
                            <InputText id="imageUrl" type="url" class="form-control" @bind-Value="hotel.ImageUrl" placeholder="https://example.com/image.jpg" />
                            <ValidationMessage For="@(() => hotel.ImageUrl)" class="text-danger" />
                        </div>
                        
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox id="isActive" class="form-check-input" @bind-Value="hotel.IsActive" />
                                <label class="form-check-label" for="isActive">
                                    Hotel is active and accepting bookings
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="d-flex justify-content-between">
                        <a href="/hotels" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back to Hotels
                        </a>
                        <div>
                            <button type="button" class="btn btn-outline-primary me-2" @onclick="PreviewHotel">
                                <i class="fas fa-eye me-2"></i>Preview
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                else
                                {
                                    <i class="fas fa-save me-2"></i>
                                }
                                Register Hotel
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    
    @if (showPreview)
    {
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-eye me-2"></i>Preview
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(hotel.ImageUrl))
                    {
                        <img src="@hotel.ImageUrl" class="card-img-top mb-3" alt="@hotel.Name" style="height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center mb-3" style="height: 150px;">
                            <i class="fas fa-building fa-2x text-muted"></i>
                        </div>
                    }
                    
                    <h6 class="card-title">@(string.IsNullOrEmpty(hotel.Name) ? "Hotel Name" : hotel.Name)</h6>
                    
                    <div class="text-warning mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="fas fa-star @(i <= hotel.StarRating ? "text-warning" : "text-muted")"></i>
                        }
                    </div>
                    
                    <p class="card-text small text-muted mb-2">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        @(string.IsNullOrEmpty(hotel.City) ? "City" : hotel.City), 
                        @(string.IsNullOrEmpty(hotel.Country) ? "Country" : hotel.Country)
                    </p>
                    
                    <p class="card-text">
                        @(string.IsNullOrEmpty(hotel.Description) ? "Hotel description will appear here..." : hotel.Description)
                    </p>
                    
                    <div class="small text-muted">
                        <div class="mb-1">
                            <i class="fas fa-phone me-1"></i>@(string.IsNullOrEmpty(hotel.PhoneNumber) ? "Phone" : hotel.PhoneNumber)
                        </div>
                        <div class="mb-1">
                            <i class="fas fa-envelope me-1"></i>@(string.IsNullOrEmpty(hotel.Email) ? "Email" : hotel.Email)
                        </div>
                        @if (!string.IsNullOrEmpty(hotel.Website))
                        {
                            <div>
                                <i class="fas fa-globe me-1"></i>@hotel.Website
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Hotel hotel = new() { StarRating = 3, IsActive = true };
    private bool isSubmitting = false;
    private bool showPreview = false;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        
        try
        {
            hotel.CreatedDate = DateTime.Now;
            DbContext.Hotels.Add(hotel);
            await DbContext.SaveChangesAsync();
            
            ToastService.ShowSuccess($"Hotel '{hotel.Name}' has been registered successfully!");
            Navigation.NavigateTo("/hotels");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error registering hotel: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void PreviewHotel()
    {
        showPreview = !showPreview;
    }
}