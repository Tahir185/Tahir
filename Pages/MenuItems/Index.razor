@page "/menuitems"
@using HotelPortal.Data
@using HotelPortal.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Menu Items - Hotel Portal</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-0">
            <i class="fas fa-utensils me-2 text-success"></i>Menu Items
        </h1>
        <p class="text-muted mb-0">Manage your hotel menus and food items</p>
    </div>
    <a href="/menuitems/create" class="btn btn-success">
        <i class="fas fa-plus me-2"></i>Add Menu Item
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <select class="form-select" @bind="selectedHotelId" @bind:after="OnFilterChanged">
            <option value="0">All Hotels</option>
            @foreach (var hotel in hotels)
            {
                <option value="@hotel.Id">@hotel.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="selectedCategory" @bind:after="OnFilterChanged">
            <option value="">All Categories</option>
            @foreach (var category in categories)
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <div class="input-group">
            <span class="input-group-text">
                <i class="fas fa-search"></i>
            </span>
            <input type="text" class="form-control" placeholder="Search menu items..." @bind="searchTerm" @bind:after="OnSearchChanged" />
        </div>
    </div>
    <div class="col-md-2">
        <select class="form-select" @bind="showAvailableOnly" @bind:after="OnFilterChanged">
            <option value="false">All Items</option>
            <option value="true">Available Only</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading menu items...</p>
    </div>
}
else if (!menuItems.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
        <h3 class="text-muted">No Menu Items Found</h3>
        <p class="text-muted">Start by adding your first menu item.</p>
        <a href="/menuitems/create" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Add Menu Item
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var menuItem in menuItems)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm menu-card">
                    @if (!string.IsNullOrEmpty(menuItem.ImageUrl))
                    {
                        <img src="@menuItem.ImageUrl" class="card-img-top" alt="@menuItem.Name" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fas fa-utensils fa-3x text-muted"></i>
                        </div>
                    }
                    
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@menuItem.Name</h5>
                            <span class="badge bg-primary">@menuItem.Category</span>
                        </div>
                        
                        <p class="card-text text-muted small mb-2">
                            <i class="fas fa-building me-1"></i>@(menuItem.Hotel?.Name ?? "Unknown Hotel")
                        </p>
                        
                        <p class="card-text flex-grow-1">
                            @(string.IsNullOrEmpty(menuItem.Description) ? "No description available" : menuItem.Description)
                        </p>
                        
                        <div class="row g-2 mb-3 small">
                            <div class="col-6">
                                <strong class="text-success">$@menuItem.Price.ToString("F2")</strong>
                            </div>
                            <div class="col-6 text-end">
                                @if (menuItem.Calories.HasValue)
                                {
                                    <span class="text-muted">@menuItem.Calories cal</span>
                                }
                            </div>
                        </div>
                        
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @if (menuItem.IsVegetarian)
                            {
                                <span class="badge bg-success">Vegetarian</span>
                            }
                            @if (menuItem.IsVegan)
                            {
                                <span class="badge bg-success">Vegan</span>
                            }
                            @if (menuItem.IsGlutenFree)
                            {
                                <span class="badge bg-info">Gluten-Free</span>
                            }
                            @if (menuItem.PreparationTimeMinutes.HasValue)
                            {
                                <span class="badge bg-secondary">@menuItem.PreparationTimeMinutes min</span>
                            }
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group" role="group">
                                <a href="/menuitems/edit/@menuItem.Id" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteMenuItem(menuItem)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            <span class="badge @(menuItem.IsAvailable ? "bg-success" : "bg-secondary")">
                                @(menuItem.IsAvailable ? "Available" : "Unavailable")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MenuItem> menuItems = new();
    private List<Hotel> hotels = new();
    private List<string> categories = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string selectedCategory = string.Empty;
    private int selectedHotelId = 0;
    private bool showAvailableOnly = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadHotels();
        await LoadCategories();
        await LoadMenuItems();
    }

    private async Task LoadMenuItems()
    {
        isLoading = true;
        
        var query = DbContext.MenuItems.Include(m => m.Hotel).AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(m => m.Name.Contains(searchTerm) || 
                                   m.Description.Contains(searchTerm) ||
                                   m.Category.Contains(searchTerm));
        }

        if (!string.IsNullOrWhiteSpace(selectedCategory))
        {
            query = query.Where(m => m.Category == selectedCategory);
        }

        if (selectedHotelId > 0)
        {
            query = query.Where(m => m.HotelId == selectedHotelId);
        }

        if (showAvailableOnly)
        {
            query = query.Where(m => m.IsAvailable);
        }

        menuItems = await query.OrderBy(m => m.Category).ThenBy(m => m.Name).ToListAsync();
        isLoading = false;
    }

    private async Task LoadHotels()
    {
        hotels = await DbContext.Hotels.OrderBy(h => h.Name).ToListAsync();
    }

    private async Task LoadCategories()
    {
        categories = await DbContext.MenuItems
            .Select(m => m.Category)
            .Distinct()
            .OrderBy(c => c)
            .ToListAsync();
    }

    private async Task OnSearchChanged()
    {
        await LoadMenuItems();
    }

    private async Task OnFilterChanged()
    {
        await LoadMenuItems();
    }

    private async Task DeleteMenuItem(MenuItem menuItem)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to delete '{menuItem.Name}'? This action cannot be undone.");
        
        if (confirmed)
        {
            DbContext.MenuItems.Remove(menuItem);
            await DbContext.SaveChangesAsync();
            await LoadMenuItems();
        }
    }
}

<style>
    .menu-card {
        transition: transform 0.2s ease-in-out;
    }
    
    .menu-card:hover {
        transform: translateY(-5px);
    }
</style>